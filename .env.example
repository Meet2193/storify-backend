# Server Configuration
APP_SRV_P=3000
APP_ENV_M=development

# Database Configuration
APP_DB_U=mongodb://localhost:27017/storify

# Security Configuration
APP_AUTH_S=your_very_long_and_secure_secret_key
APP_AUTH_E=24h
APP_SEC_O=http://localhost:3000

# Storage Configuration
APP_UPLOAD_DIR=uploads
APP_MAX_FILE_SIZE=52428800
APP_STG_DRIVER=local

# Bunny Storage Provider Settings (Active when APP_STG_DRIVER=bunny)
APP_STG_ZN=your_bunny_storage_zone_name
APP_STG_AK=your_bunny_storage_access_key
APP_STG_REG=de
APP_STG_CDN=
APP_STG_TIMEOUT=30000

# Application Configuration (Neutral naming for business logic)
APP_VAL_1=50
APP_VAL_2=false
APP_VAL_3=300
